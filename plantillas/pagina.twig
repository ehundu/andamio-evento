{% extends 'plantillas/base.twig' %}

{# El layout de las páginas de texto (preguntas frecuentes, código de conducta, textos legales, 404): lo que no dice
   `plantilla` en su front matter usa este #}
{% block cuerpo %}
<article class="contenedor pagina">
  <h1>{{ pagina.titulo }}</h1>
  <div class="prosa">{{ pagina.contenido }}</div>
</article>
{% endblock %}
